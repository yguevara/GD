<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{7C1F5B2A-4D3E-4A86-9B10-5E6F7A8B9C0D}</ProjectGuid>
    <ProjectVersion>18.6</ProjectVersion>
    <FrameworkType>None</FrameworkType>
    <MainSource>PruebasArchiGenio.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>1</TargetedPlatforms>
    <AppType>Console</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <DCC_UnitSearchPath>..;$(BDS)\source\DUnitX;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
    <DCC_ExeOutput>.\Win32\$(Config)</DCC_ExeOutput>
    <DCC_DcuOutput>.\Win32\$(Config)</DCC_DcuOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
    <Config>Debug</Config>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <DCC_DebugInformation>2</DCC_DebugInformation>
    <DCC_Optimize>False</DCC_Optimize>
    <DCC_GenerateStackFrames>True</DCC_GenerateStackFrames>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <CfgParent>Base</CfgParent>
    <Config>Release</Config>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2)'!=''">
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_Optimize>True</DCC_Optimize>
    <DCC_LocalDebugSymbols>False</DCC_LocalDebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="UPruebaHumo.pas"/>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Application</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">PruebasArchiGenio.dpr</Source>
        </Source>
      </Delphi.Personality>
    </BorlandProject>
  </ProjectExtensions>
  <Import Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" Project="$(BDS)\Bin\CodeGear.Delphi.Targets"/>
  <Import Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABaseDir)\$(ProductVersion)\UserTools.proj')" Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABaseDir)\$(ProductVersion)\UserTools.proj"/>
</Project>
