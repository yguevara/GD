  object cmdServer: TFDQuery
    Connection = UDM.Conn
    SQL.Strings = (
      
        'SELECT cl_ftp_Server.Idservidor, cl_ftp_Server.etiquetaServ, cl_' +
        'ftp_Server.ipserver, cl_ftp_Server.path, cl_ftp_Server.user, cl_' +
        'ftp_Server.pass, cl_ftp_Server.puerto'
      'FROM cl_ftp_Server where idservidor=:Acod;')
    Left = 1105
    Top = 361
    ParamData = <
      item
        Name = 'ACOD'
        DataType = ftString
        ParamType = ptInput
        Value = '1'
      end>
  end
