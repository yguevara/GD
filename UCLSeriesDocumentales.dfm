  object cmdArch: TFDQuery
    Connection = UDM.Conn
    SQL.Strings = (
      
        'SELECT cl_ArchivosGestion.Cod, cl_ArchivosGestion.nombreArchivo,' +
        ' cl_ArchivosGestion.Tipo, cl_ArchivosGestion.Idresp, cl_Archivos' +
        'Gestion.croquis, cl_ArchivosGestion.Foto, cl_ArchivosGestion.Des' +
        'cripcion'
      'FROM cl_ArchivosGestion WHERE Cod=:Acod;')
    Left = 817
    Top = 361
    ParamData = <
      item
        Name = 'ACOD'
        DataType = ftString
        ParamType = ptInput
        Value = '1'
      end>
  end
