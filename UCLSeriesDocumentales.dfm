      object ADOQuery1: TfrxADOQuery
        UserName = 'ADOQuery1'
        CloseDataSource = True
        BCDToCurrency = False
        DataSetOptions = []
        Master = frxMain.cl_series
        IgnoreDupParams = False
        Params = <>
        SQL.Strings = (
          'SELECT '
          '    cl_subseries.codserie,'
          '    cl_subseries.codsubs,'
          '    cl_subseries.subserie,'
          '    cl_soporte.Nombresoporte AS Soporte,'
          '    cl_tipodoc.Tipodoc,'
          '    cl_subseries.Activa,'
          '    cl_valordoc.Valordoc,'
          '    cl_vigencia.vigencia,'
          '    cl_subseries.ayear AS A'#241'o,'
          '    cl_subseries.tgestion,'
          '    cl_subseries.tcentral,'
          '    cl_destino.NombreDestino AS Destino,'
          '    cl_acceso.NombreAcceso AS Acceso,'
          '    cl_frecuencia.NombreFrecuencia AS Frecuencia,'
          '    cl_tiposerie.tiposerie,'
          '    cl_subseries.fechaaprov'
          'FROM (((((((cl_subseries '
          
            'LEFT JOIN cl_soporte ON cl_subseries.soporte = cl_soporte.Idsopo' +
            'rte) '
          
            'LEFT JOIN cl_tipodoc ON cl_subseries.tipodoc = cl_tipodoc.Idtipo' +
            'doc) '
          
            'LEFT JOIN cl_valordoc ON cl_subseries.Detalle = cl_valordoc.Idti' +
            'podoc) '
          
            'LEFT JOIN cl_vigencia ON cl_subseries.Vigencia = cl_vigencia.idv' +
            'igencia) '
          
            'LEFT JOIN cl_destino ON cl_subseries.destino = cl_destino.IdDest' +
            'ino) '
          
            'LEFT JOIN cl_acceso ON cl_subseries.acceso = cl_acceso.Idacceso)' +
            ' '
          
            'LEFT JOIN cl_frecuencia ON cl_subseries.frecuencia = cl_frecuenc' +
            'ia.Idfrecuencia) '
          
            'LEFT JOIN cl_tiposerie ON cl_subseries.idtiposerie = cl_tiposeri' +
            'e.idtiposerie;  '
          '  ')
        CommandTimeout = 30
        Database = frxMain.conn
        LockType = ltReadOnly
        pLeft = 336
        pTop = 292
        Parameters = <>
      end
      object ADOQuery2: TfrxADOQuery
        UserName = 'ADOQuery2'
        CloseDataSource = True
        BCDToCurrency = False
        DataSetOptions = []
        Master = frxMain.cl_series
        IgnoreDupParams = False
        Params = <>
        SQL.Strings = (
          
            'SELECT cl_VarSubserie.codserie, cl_VarSubserie.codsubs, cl_VarSu' +
            'bserie.Orden, cl_VarSubserie.NomVariable, cl_VarSubserie.Etiquet' +
            'a, CL_SubseriesTipoVar.tipo, cl_VarSubserie.longitud, cl_VarSubs' +
            'erie.descripcion'
          
            'FROM cl_VarSubserie INNER JOIN CL_SubseriesTipoVar ON cl_VarSubs' +
            'erie.tipo = CL_SubseriesTipoVar.Idtipo;'
          '  ')
        CommandTimeout = 30
        Database = frxMain.conn
        LockType = ltReadOnly
        pLeft = 464
        pTop = 292
        Parameters = <>
      end
    end
