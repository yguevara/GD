  end
  object cmdGestor: TFDQuery
    Connection = UDM.Conn
    SQL.Strings = (
      
        'SELECT cl_Resp_Gest_Arch.Idresp, cl_Resp_Gest_Arch.NombreRespons' +
        'able, cl_Resp_Gest_Arch.usuario, cl_Resp_Gest_Arch.password, cl_' +
        'Resp_Gest_Arch.CorreoElect, tb_rol.rol, cl_Resp_Gest_Arch.Telefo' +
        'no'
      
        'FROM tb_rol RIGHT JOIN cl_Resp_Gest_Arch ON tb_rol.idrol = cl_Re' +
        'sp_Gest_Arch.Rol'
      'WHERE (((cl_Resp_Gest_Arch.[idresp])=:RESP));')
    Left = 697
    Top = 369
    ParamData = <
      item
        Name = 'RESP'
        DataType = ftString
        ParamType = ptInput
        Value = '1'
      end>
  end
