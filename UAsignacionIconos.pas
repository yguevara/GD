procedure CargarIcono(Icono: TIconoAsignacion; Destino: TBitmap);
var
  Datos: string;
  Bytes: TBytes;
  Flujo: TBytesStream;
begin
  case Icono of
    iaAsignacion: Datos := DATOS_ASIGNACION;
    iaCerrar: Datos := DATOS_CERRAR;
    iaReporte: Datos := DATOS_REPORTE;
  else
    Datos := DATOS_AYUDA;
  end;
  Bytes := TNetEncoding.Base64.DecodeStringToBytes(Datos);
  Flujo := TBytesStream.Create(Bytes);
  try
    Destino.LoadFromStream(Flujo);
  finally
    Flujo.Free;
  end;
end;

end.
